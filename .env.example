# Auth.js session encryption secret: openssl rand -base64 33
AUTH_SECRET=""

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3300/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Supabase Postgres for the API (api/). Supabase dashboard → Connect → Session pooler.
# The direct connection host is IPv6-only, so use the session pooler (port 5432).
DATABASE_URL=""

# Shared secret: Next.js signs short-lived API tokens with it, FastAPI verifies them.
# openssl rand -base64 33
API_SECRET=""
API_URL="http://localhost:8000"

# Serve the API docs (Swagger UI at http://localhost:8000/docs, ReDoc, /openapi.json) for
# developers. Never set it in production: the browser never calls the API (docs/adr/0001).
API_DOCS="true"

# Sentry error monitoring (BIG-14). Leave blank locally to send nothing; required in production.
# DSNs: sentry.io → Settings → Projects → bigfoot-frontend / bigfoot-server → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Build-time only: uploads source maps. An organization token from sentry.io → Settings →
# Organization Tokens. Never commit it.
SENTRY_AUTH_TOKEN=""
