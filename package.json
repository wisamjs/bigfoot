{
  "name": "bigfoot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/check-tokens.mjs",
    "stories": "node scripts/check-stories.mjs",
    "spell": "cspell --no-progress --no-summary",
    "test": "vitest run --coverage --project unit --project components",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test-storybook": "vitest run --project storybook",
    "lint:api": "cd api && uv run ruff check . ../scripts && uv run ruff format --check . ../scripts",
    "verify": "npm run spell && npm run tokens && npm run stories && npm run lint:api && npm run test:api:unit && npm run openapi -- --check && npm run typecheck && npm run lint && npm run test && npm run test-storybook",
    "check": "echo 'npm run check is deprecated: use npm run verify' >&2 && npm run verify",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "capture": "node scripts/capture.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "pr-check": "node scripts/pr-check.mjs",
    "ci-failures": "node scripts/ci-failures.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "openapi": "cd api && uv run python ../scripts/openapi.py",
    "dev:api": "cd api && uv run uvicorn --factory app.main:create_app --port 8000 --reload",
    "test:api:unit": "cd api && uv run pytest -m 'not db' -q --cov-reset --cov=app.auth --cov=app.domain --cov=app.models --cov=app.monitoring --cov=app.responses --cov=app.samples --cov=app.settings --cov-fail-under=98",
    "test:api": "node scripts/test-schema.mjs pytest",
    "db:drop-test-schema": "node scripts/test-schema.mjs drop",
    "db:status": "cd api && uv run python ../scripts/db-status.py",
    "snapshots": "node scripts/snapshots.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.16.0",
    "@tanstack/react-table": "^9.3.1",
    "allo-font": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cspell/dict-en-ca": "1.0.69",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "cspell": "10.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "happy-dom": "^21.0.4",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "storybook": "10.6.6",
    "storybook-addon-pseudo-states": "10.6.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
