{
  "name": "bigfoot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/check-tokens.mjs",
    "spell": "cspell --no-progress --no-summary",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:api": "cd api && uv run ruff check . ../scripts && uv run ruff format --check . ../scripts",
    "check": "npm run typecheck && npm run lint && npm run lint:api && npm run openapi -- --check && npm run tokens && npm run spell && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "capture": "node scripts/capture.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "openapi": "cd api && uv run python ../scripts/openapi.py",
    "dev:api": "cd api && uv run uvicorn --factory app.main:create_app --port 8000 --reload",
    "test:api": "node scripts/test-schema.mjs pytest",
    "db:drop-test-schema": "node scripts/test-schema.mjs drop",
    "db:status": "cd api && uv run python ../scripts/db-status.py"
  },
  "dependencies": {
    "@sentry/nextjs": "11.16.0",
    "@tanstack/react-table": "^9.3.1",
    "allo-font": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cspell/dict-en-ca": "1.0.69",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "cspell": "10.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
