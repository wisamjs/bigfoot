{
  "name": "bigfoot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/check-tokens.mjs",
    "check": "npm run typecheck && npm run lint && npm run tokens",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:api": "cd api && uv run uvicorn --factory app.main:create_app --port 8000 --reload",
    "test:api": "cd api && uv run pytest",
    "db:status": "cd api && uv run python ../scripts/db-status.py"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
