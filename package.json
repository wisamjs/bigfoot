{
  "name": "bigfoot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "tokens": "node scripts/check-tokens.mjs",
    "spell": "cspell --no-progress --no-summary",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:api": "cd api && uv run ruff check . ../scripts && uv run ruff format --check . ../scripts",
    "check": "npm run typecheck && npm run lint && npm run lint:api && npm run tokens && npm run spell && npm run test",
    "smoke": "node scripts/smoke.mjs",
    "a11y": "node scripts/a11y.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "capture": "node scripts/capture.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:api": "cd api && uv run uvicorn --factory app.main:create_app --port 8000 --reload",
    "test:api": "cd api && uv run pytest",
    "db:status": "cd api && uv run python ../scripts/db-status.py"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cspell/dict-en-ca": "1.0.69",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "cspell": "10.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
