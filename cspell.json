{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-CA",
  "import": [
    "@cspell/dict-en-ca/cspell-ext.json"
  ],
  "flagWords": [
    "behavior",
    "behaviors",
    "behavioral",
    "color",
    "colors",
    "colored",
    "colorful",
    "center",
    "centers",
    "centered",
    "honor",
    "honors",
    "honored",
    "favor",
    "favors",
    "favorite",
    "favorites",
    "neighbor",
    "neighbors",
    "labor",
    "catalog",
    "catalogs",
    "defense",
    "offense",
    "canceled",
    "canceling",
    "labeled",
    "labeling",
    "modeled",
    "modeling",
    "traveled",
    "traveling",
    "fulfill",
    "fulfillment",
    "enrollment"
  ],
  "ignoreRegExpList": [
    "/[\\w:\\[\\]./]*-(?:center|colors?|gray|behavior)\\b[\\w:\\-\\[\\]./]*/g",
    "/\\b(?:center|colors?|gray)-[\\w:\\-\\[\\]./]*/g"
  ],
  "words": [
    "Airtable",
    "authjs",
    "autouse",
    "Cedarline",
    "delenv",
    "dialogs",
    "dotenv",
    "d’accès",
    "elses",
    "fastapi",
    "labelledby",
    "lineterm",
    "Northwind",
    "pooler",
    "posthog",
    "pyproject",
    "pytest",
    "redoc",
    "subprocessor",
    "subprocessors",
    "Supabase",
    "trblse",
    "typeui",
    "uvicorn",
    "Vercel",
    "WCAG",
    "Wisam",
    "wisamzaghal",
    "Wordmark",
    "Zaghal"
  ],
  "files": [
    "**/*.md",
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,py}",
    "api/**/*.py",
    ".github/**/*.yml"
  ],
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "api/.venv/**",
    ".claude/**",
    ".agents/**"
  ]
}
