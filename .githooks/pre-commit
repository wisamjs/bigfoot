#!/bin/sh
# npm run verify (spelling, design tokens, stories present, Python lint, the staged OpenAPI schema, types, lint,
# then every Vitest test with the coverage floor, then the story tests in Chrome) before every commit; a failing test blocks it.
# Committing is the verify run: AGENTS.md and the pick-up-ticket skill rely on it.
# A commit of only .md files runs just the spelling check, as CI's review gate skips them too
# (scripts/review-needed.mjs).
# A worktree without its own node_modules is stopped first: see scripts/check-worktree-packages.mjs.
# Installed by `npm install` (the "prepare" script) and by the SessionStart hook in .claude/settings.json.
node scripts/check-worktree-packages.mjs || exit 1
staged=$(git diff --cached --name-only)
if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qv '\.md$'; then
  exec npm run --silent spell
fi
exec npm run --silent verify
