  "components": {
    "schemas": {
      "Application": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "company": {
            "type": "string",
            "title": "Company",
            "description": "The company the job seeker applied to.",
            "examples": [
              "Northwind Robotics"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The role's job title.",
            "examples": [
              "Frontend Engineer"
            ]
          },
          "posting_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posting Url",
            "description": "The job posting, as an http(s) URL.",
            "examples": [
              "https://jobs.example.com/northwind/frontend-engineer"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Where the role is, as the job seeker writes it.",
            "examples": [
              "Remote"
            ]
          },
          "salary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary",
            "description": "The pay range, as the job seeker writes it.",
            "examples": [
              "$120k–$140k"
            ]
          },
          "applied_on": {
            "type": "string",
            "format": "date",
            "title": "Applied On",
            "description": "When the job seeker applied.",
            "examples": [
              "2026-11-02"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "done"
            ],
            "title": "Status",
            "description": "Whether the Application is still going (GLOSSARY.md, Status)."
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "offer",
                  "rejected",
                  "position_filled",
                  "withdrawn",
                  "no_open_position",
                  "not_the_right_fit"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome",
            "description": "How a Done Application ended. Required when the status is `done`, and only then."
          },
          "interviews": {
            "items": {
              "$ref": "#/components/schemas/Interview"
            },
            "type": "array",
            "title": "Interviews",
            "description": "Ordered by date, undated first."
          },
          "is_waiting": {
            "type": "boolean",
            "title": "Is Waiting",
            "description": "Derived (GLOSSARY.md, Waiting): In Progress with no upcoming Interview, including a new one."
          },
          "waiting_since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting Since",
            "description": "While waiting: when the last dated, completed Interview happened (a timestamp), or else the applied date. Null when not waiting.",
            "examples": [
              "2026-11-08T17:00:00Z"
            ]
          },
          "is_sample": {
            "type": "boolean",
            "title": "Is Sample",
            "description": "A Sample Application that Bigfoot created for a new job seeker."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "company",
          "title",
          "posting_url",
          "location",
          "salary",
          "applied_on",
          "status",
          "outcome",
          "interviews",
          "is_waiting",
          "waiting_since",
          "is_sample",
          "created_at",
          "updated_at"
        ],
        "title": "Application",
        "description": "One role at one company that the job seeker has applied to, with its Interviews."
      },
      "ApplicationCreate": {
        "properties": {
          "company": {
            "type": "string",
            "title": "Company",
            "description": "The company the job seeker applied to.",
            "examples": [
              "Northwind Robotics"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "The role's job title.",
            "examples": [
              "Frontend Engineer"
            ]
          },
          "posting_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posting Url",
            "description": "The job posting, as an http(s) URL.",
            "examples": [
              "https://jobs.example.com/northwind/frontend-engineer"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Where the role is, as the job seeker writes it.",
            "examples": [
              "Remote"
            ]
          },
          "salary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary",
            "description": "The pay range, as the job seeker writes it.",
            "examples": [
              "$120k–$140k"
            ]
          },
          "applied_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applied On",
            "description": "When the job seeker applied. Defaults to today.",
            "examples": [
              "2026-11-02"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "done"
            ],
            "title": "Status",
            "description": "Whether the Application is still going (GLOSSARY.md, Status).",
            "default": "in_progress"
          },
          "outcome": {
