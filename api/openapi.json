{
  "openapi": "3.1.0",
  "info": {
    "title": "Bigfoot API",
    "description": "Bigfoot's data API: a job seeker's Applications and their Interviews, in Supabase Postgres.\n\nThe browser never calls it. The Next.js server does, with a short-lived token naming the\nsigned-in job seeker, and every route reads and writes only that job seeker's data\n([ADR 0001](https://github.com/wisamjs/bigfoot/blob/main/docs/adr/0001-fastapi-behind-nextjs-with-authjs.md)).\nTerms such as Application, Interview, Waiting and Sample Application are defined in\n[GLOSSARY.md](https://github.com/wisamjs/bigfoot/blob/main/GLOSSARY.md).\n\nTo try a request, run `node scripts/dev-api-token.mjs`, click **Authorize** and paste the token.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check the API is up",
        "description": "Always `ok` while the API is serving. Doesn't touch the database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/me/onboard": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Onboard the job seeker",
        "description": "Record the job seeker, and give them Sample Applications the first time only.\n\nIdempotent, and safe to call concurrently: the insert waits on any other transaction\ninserting the same job seeker, and `for update` serializes the seeding check.",
        "operationId": "onboard_me_onboard_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Onboarding"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ]
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get the job seeker's record",
        "description": "The job seeker's own record, for their data export. 404 until they are onboarded.",
        "operationId": "get_job_seeker_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSeeker"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "The job seeker hasn't been onboarded yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Delete the job seeker's account",
        "description": "Delete the job seeker and all of their Applications, in one transaction.\n\nIdempotent: deleting an account that is already gone succeeds and logs nothing. Signing\nin again afterwards makes a new job seeker, who receives Sample Applications again.",
        "operationId": "delete_account_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ]
      }
    },
    "/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List the job seeker's Applications",
        "description": "Every Application of the job seeker, oldest first, each with its Interviews and Waiting data.",
        "operationId": "list_applications_applications_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  },
                  "type": "array",
                  "title": "Response List Applications Applications Get"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ]
      },
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Add an Application",
        "description": "Add an Application for the job seeker. It starts In Progress with no Interviews unless the body\nsays otherwise; a Done Application needs an Outcome.",
        "operationId": "create_application_applications_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerToken": []
          }
        ]
      }
    },
    "/applications/{application_id}": {
      "patch": {
        "tags": [
          "Applications"
        ],
        "summary": "Edit an Application",
        "description": "Change some of an Application's fields and return it with its Interviews.\n\nOnly the fields sent change. Setting the status to `in_progress` without an outcome reopens the\nApplication and clears its Outcome; setting it to `done` needs an Outcome, sent now or already set.",
        "operationId": "update_application_applications__application_id__patch",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The Application's id.",
              "title": "Application Id"
            },
            "description": "The Application's id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "No Application with this id belongs to the job seeker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "422": {
            "description": "The body is invalid (a list of field errors), or the change would leave a Done Application without an Outcome or an In Progress one with an Outcome (a message).",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/HTTPValidationError"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorMessage"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Applications"
        ],
        "summary": "Delete an Application",
        "description": "Delete an Application and all of its Interviews. Sample Applications can be deleted like any other.",
        "operationId": "delete_application_applications__application_id__delete",
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "application_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The Application's id.",
              "title": "Application Id"
            },
            "description": "The Application's id."
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "The bearer token is missing, expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "No Application with this id belongs to the job seeker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
